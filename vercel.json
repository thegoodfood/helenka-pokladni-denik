{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://hub.thegoodfood.cool" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
